from pathlib import Path
import json
import re

src = Path("/mnt/data/Pasted text(15).txt")
text = src.read_text(encoding="utf-8")

conflict_block = """<<<<<<< Updated upstream
    "com.unity.2d.sprite": {
      "version": "1.0.0",
      "depth": 0,
=======
    "com.cdm.figma": {
      "version": "https://github.com/cdmvision/unity-figma-importer.git#1.9.0",
      "depth": 0,
      "source": "git",
      "dependencies": {
        "com.unity.nuget.newtonsoft-json": "2.0.2",
        "com.unity.vectorgraphics": "2.0.0-preview.24"
      },
      "hash": "fca65130edd9ead157939e13791a6f9a3d8bd722"
    },
    "com.unity.2d.sprite": {
      "version": "1.0.0",
      "depth": 2,
>>>>>>> Stashed changes"""

replacement = """"com.cdm.figma": {
      "version": "https://github.com/cdmvision/unity-figma-importer.git#1.9.0",
      "depth": 0,
      "source": "git",
      "dependencies": {
        "com.unity.nuget.newtonsoft-json": "2.0.2",
        "com.unity.vectorgraphics": "2.0.0-preview.24"
      },
      "hash": "fca65130edd9ead157939e13791a6f9a3d8bd722"
    },
    "com.unity.2d.sprite": {
      "version": "1.0.0",
      "depth": 0,"""

if conflict_block not in text:
    raise ValueError("Expected merge-conflict block was not found exactly.")

fixed = text.replace(conflict_block, replacement)

# Ensure no conflict markers remain.
markers = ["<<<<<<<", "=======", ">>>>>>>"]
remaining = [m for m in markers if m in fixed]
if remaining:
    raise ValueError(f"Unresolved merge markers remain: {remaining}")

# Validate JSON.
data = json.loads(fixed)

# Sanity checks for the merged entries.
deps = data["dependencies"]
assert deps["com.cdm.figma"]["depth"] == 0
assert deps["com.unity.2d.sprite"]["depth"] == 0

out = Path("/mnt/data/packages-lock.json")
out.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")

print(f"Created and validated: {out}")
print(f"Packages listed: {len(deps)}")
