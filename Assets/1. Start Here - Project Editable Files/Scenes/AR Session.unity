      localRotation: {x: 0, y: 0, z: 0}
      localScale: {x: 0.01, y: 0.01, z: 0.01}
  - chapterNumber: 3
    pageType: 1
    title: Mariposa the Monarch Butterfly
    description: 'Scientific Name: Danaus plexippus'
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 3
    pageType: 2
    title: Mariposa
    description: "Hi, I\u2019m Mariposa the Monarch! I\u2019ve traveled a long way
      to be here in San Luis Obispo."
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 3
    pageType: 2
    title: Mariposa
    description: "Even though I\u2019ve lost a lot of my habitat in San Luis Obispo
      over the years, you can still help me and my family recover and grow!"
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 3
    pageType: 2
    title: Mariposa
    description: Us butterflies do well when we have certain plants around.
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 3
    pageType: 2
    title: Mariposa
    description: "One plant that helps us is Narrowleaf Milkweed. We also like Showy
      Milkweed too! They serve as places for our baby butterflies to grow. Let\u2019s
      plant some!"
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 3
    pageType: 3
    title: 
    description: 
    image: {fileID: 0}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn:
    - prefab: {fileID: 3279093614907120051, guid: a88aaf6189bd44cbba8c8869121c67cc, type: 3}
      localPosition: {x: 0, y: 0, z: 0}
      localRotation: {x: 0, y: 0, z: 0}
      localScale: {x: 0.01, y: 0.01, z: 0.01}
    - prefab: {fileID: 3279093614907120051, guid: a88aaf6189bd44cbba8c8869121c67cc, type: 3}
