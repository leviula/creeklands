      localRotation: {x: 0, y: 0, z: 0}
      localScale: {x: 0.01, y: 0.01, z: 0.01}
  - chapterNumber: 3
    pageType: 2
    title: Mariposa
    description: "My pollinator friends also like milkweed. For example, my friend,
      the Crotch\u2019s Bumble Bee, also likes Showy Milkweed! Bring her to the milkweed
      she likes!"
    image: {fileID: 21300000, guid: 8ee8fea619ada40e1a3648a542479384, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
