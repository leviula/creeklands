      localScale: {x: 0.01, y: 0.01, z: 0.01}
  - chapterNumber: 1
    pageType: 1
    title: Cardinal Meadowhawk
    description: 'Scientific Name: Sympetrum illotum'
    image: {fileID: 21300000, guid: 984316be97ff042b4a7ba10151d41c40, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 1
    pageType: 2
    title: Cardinal Meadowhawk
    description: Hello, yesterday, the bullfrog ate my friend!
    image: {fileID: 21300000, guid: 984316be97ff042b4a7ba10151d41c40, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 1
    pageType: 3
    title: 
    description: 
    image: {fileID: 0}
