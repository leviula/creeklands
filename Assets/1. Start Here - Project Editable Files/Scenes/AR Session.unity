    - prefab: {fileID: 170896411}
      localPosition: {x: 0, y: 0, z: 0}
      localRotation: {x: 0, y: 0, z: 0}
      localScale: {x: 0.01, y: 0.01, z: 0.01}
  - chapterNumber: 1
    pageType: 1
    title: Tricolored Blackbird
    description: 'Scientific Name: Agelaius tricolor'
    image: {fileID: 21300000, guid: 0834fe0e596e74d249297272fc137a3d, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 1
    pageType: 2
    title: Tricolored Blackbird
    description: "That bullfrog will eat just about anything it can capture and swallow.
      I even saw him try to eat a bird! I\u2019m very worried about my little nestlings!"
    image: {fileID: 21300000, guid: 0834fe0e596e74d249297272fc137a3d, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 1
    pageType: 2
    title: Ripple
    description: "Oh no! Sounds like the bullfrog is an invasive species! Let\u2019s
      report this sighting to the California Department of Fish and Wildlife so they
      can take care of it."
    image: {fileID: 21300000, guid: 0768d2850e753496199ff16ff8e10805, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 1
    pageType: 2
    title: Ripple
    description: 'Wow, thank you so much! You really helped the creek today. '
    image: {fileID: 21300000, guid: 0768d2850e753496199ff16ff8e10805, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 3
    title: 
    description: 
    image: {fileID: 0}
