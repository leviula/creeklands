    label2: None
    objectsToSpawn: []
  - chapterNumber: 0
    pageType: 2
    title: Cero
    description: "There\u2019s so much to discover here, I can\u2019t wait for you
      to to get to know my creek home!"
    image: {fileID: 21300000, guid: b8535b9a16c1a40399ccbccb86b0c62b, type: 3}
