      localPosition: {x: 0, y: 0, z: 0}
      localRotation: {x: 0, y: 0, z: 0}
      localScale: {x: 0.01, y: 0.01, z: 0.01}
  - chapterNumber: 2
    pageType: 1
    title: Skipper the Steelhead Trout
    description: 'Scientific Name: Oncorhynchus mykiss'
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: Hi there! I'm Skipper the Steelhead Trout!
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: "I was born here in this creek, but now it\u2019s time for me to
      head out and find food on my own."
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: "Help me swim through the creek and make my way to the ocean! There\u2019s
      more food over there, so I can grow even bigger!"
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 1
    title: Tule Rush
    description: 'Scientific Name: Schoenoplectus acutus'
    image: {fileID: 21300000, guid: eed66de1be41c4265865ca876ab1eaad, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: Oh hey, look, this is a tule rush!
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: I like to forage here for food and hide when I need to find a safe
      place from dangerous predators.
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 1
    title: Mallard Duck
    description: 'Scientific Name: Anas platyrhynchos'
    image: {fileID: 21300000, guid: 0eec3219a2ffc4e4ba27fb6f546fb015, type: 3}
    hideButton: 0
    label1: Local
    label2: Native
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Mallard Duck
    description: Hmm... I think I see something swimming down there.
    image: {fileID: 21300000, guid: 0eec3219a2ffc4e4ba27fb6f546fb015, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: "Uh-oh! If the ducks spot me, I could get caught! It can\u2019t
      know I\u2019m here, quick, help me find a place to hide!"
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Mallard Duck
    description: "Huh... that\u2019s strange. I thought I saw a steelhead trout.
      Maybe it was just my imagination."
    image: {fileID: 21300000, guid: 0eec3219a2ffc4e4ba27fb6f546fb015, type: 3}
    hideButton: 1
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: "Whew! Thanks for helping me hide. That was a close one! Let\u2019s
      keep going!"
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: "Oh no! There\u2019s a giant concrete wall blocking my way!"
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: Can you help clear the path so I can keep swimming and find food
      on the other side?
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
  - chapterNumber: 2
    pageType: 2
    title: Skipper
    description: Hooray! You cleared the path for me! Thanks for helping me continue
      my journey!
    image: {fileID: 21300000, guid: d3f5a2f27e2f9486a8bbb7e061bcd7e9, type: 3}
    hideButton: 0
    label1: 
    label2: 
    objectsToSpawn: []
